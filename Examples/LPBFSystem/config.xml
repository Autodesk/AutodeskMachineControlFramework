				<content name="buildheader" cardstyle="elevated" columnstart="1" rowstart="1" columnend="3" rowend="1" rowposition="centered">

					<form name="buildheaderform">
						<edit name="buildname" caption="Build Name" sync:value="main.jobinfo.jobname" readonly="1"/>
