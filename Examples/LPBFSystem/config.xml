				</buildlist>
			</content>
		</page>

		<page name="buildhistory">
			<content name="executionlibrary" cardstyle="elevated" title="Build History">

				<paragraph text="Browse past build executions and load their journals for analysis." variant="subtext"/>

				<separator name="sep_history" orientation="horizontal" variant="light"/>

				<executionlist loadingtext="Loading builds" entriesperpage="20" selectevent="" thumbnail="thumbnail_default">
